# Docker ignore for production build
# Dependencies (will be installed in container)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Build output
.next/
out/
dist/
build/

# Large files
public/uploads/
*.log
*.tmp

# Git
.git/
.gitignore
.gitattributes

# Documentation
*.md
!README.md

# IDE files
.vscode/
.idea/
*.swp
*.swo

# Test files
**/*.test.*
**/*.spec.*
coverage/
__tests__/
jest.config.*
cypress/

# Environment files
.env.local
.env.development
.env.test
.env.production
.env*.local

# Docker files (not needed in image)
docker-compose*.yml
Dockerfile.fast
Dockerfile.local
docker-manage.ps1
docker-hub-push.ps1

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Prisma database files (but keep schema.prisma!)
prisma/*.db
prisma/*.db-journal
prisma/dev.db*

# Backup files
*.backup
*.bak
*.old