# Production Environment Variables for cPanel Deployment
# Database Configuration
DATABASE_URL="mysql://username:password@localhost:3306/database_name"

# JWT Configuration
JWT_SECRET="your-super-secure-jwt-secret-key-here-64-chars-minimum"

# App Configuration
NODE_ENV="production"
NEXTAUTH_URL="https://mekarmukti.id"
NEXTAUTH_SECRET="your-nextauth-secret-key-here"

# Developer Mode (set to false in production)
ENABLE_DEVELOPER_MODE="false"

# Database Pool Settings for cPanel
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# Security Settings
BCRYPT_ROUNDS=12
SESSION_MAX_AGE=86400

# File Upload Settings (for cPanel limits)
MAX_FILE_SIZE=5242880
MAX_UPLOAD_FILES=10

# Production Optimization
NEXT_TELEMETRY_DISABLED=1