# Production Environment Variables
# Copy this file to .env.production and fill in the values

# ====================================
# DATABASE CONFIGURATION
# ====================================
MYSQL_ROOT_PASSWORD=your-super-secure-root-password-here-change-this
MYSQL_DATABASE=koperasi_umb_production
MYSQL_USER=koperasi_app
MYSQL_PASSWORD=your-secure-db-password-here-change-this

# Database URL for Prisma
DATABASE_URL="mysql://koperasi_app:your-secure-db-password-here-change-this@mysql:3306/koperasi_umb_production"

# ====================================
# NEXTAUTH CONFIGURATION
# ====================================
# Generate secret: openssl rand -base64 32
NEXTAUTH_SECRET=your-nextauth-secret-generate-with-openssl-rand-base64-32

# Production URL (replace with your domain)
NEXTAUTH_URL=https://koperasi.umb.ac.id

# Session duration (8 hours = 28800 seconds)
NEXTAUTH_SESSION_MAX_AGE=28800

# ====================================
# NODE ENVIRONMENT
# ====================================
NODE_ENV=production

# ====================================
# APPLICATION SETTINGS
# ====================================
# Timezone
TZ=Asia/Jakarta

# Log level (error, warn, info, debug)
LOG_LEVEL=info

# ====================================
# SECURITY SETTINGS
# ====================================
# Rate limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# CORS Origins (if needed for external integrations)
# CORS_ORIGINS=https://koperasi.umb.ac.id,https://www.umb.ac.id

# ====================================
# BACKUP CONFIGURATION
# ====================================
BACKUP_RETENTION_DAYS=30
BACKUP_PATH=/backups

# ====================================
# MONITORING (Optional)
# ====================================
# UptimeRobot webhook (if you use monitoring)
# UPTIME_ROBOT_WEBHOOK=https://api.uptimerobot.com/v2/newMonitor

# Sentry DSN (if you use error tracking)
# SENTRY_DSN=https://your-sentry-dsn-here

# ====================================
# SMTP CONFIGURATION (Optional - for email notifications)
# ====================================
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@umb.ac.id
# SMTP_PASSWORD=your-app-password
# SMTP_FROM=noreply@umb.ac.id

# ====================================
# NOTES
# ====================================
# 1. NEVER commit this file with real secrets to Git
# 2. Change ALL passwords and secrets before deploying
# 3. Use strong passwords (minimum 20 characters)
# 4. Generate NEXTAUTH_SECRET with: openssl rand -base64 32
# 5. Keep a secure backup of this file
